{
  "opencollection": "1.0.0",
  "info": {
    "name": "Deel ATS Adjustments Reference Data API",
    "version": "2026-05-25"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Reference Data",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List ATS Departments",
            "type": "http"
          },
          "http": {
            "method": "GET",
