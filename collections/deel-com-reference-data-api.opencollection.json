          },
          "docs": "List ATS Departments"
        },
        {
          "info": {
            "name": "List ATS Employment Types",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.letsdeel.com/rest/v2/ats/employment-types"
          },
          "docs": "List ATS Employment Types"
        },
        {
          "info": {
            "name": "List ATS Locations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.letsdeel.com/rest/v2/ats/locations"
          },
          "docs": "List ATS Locations"
        }
      ]
    }
  ],
  "bundled": true
}