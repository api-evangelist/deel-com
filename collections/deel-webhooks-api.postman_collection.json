  "info": {
    "_postman_id": "f72ee904-187b-4b58-945f-691085c6e757",
    "name": "Deel Webhooks API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Webhook management API and event catalog for real-time notifications across contracts,\ninvoices, payroll, time off, EOR onboarding, ATS, and worker lifecycle events. Webhook\npayloads are HMAC-SHA256 signed and can be simulated from the Developer Center without\naffecting production data.\n\n\nContact Support:\n Name: Deel Developer Support",
      "type": "text/plain"
    }
  }
