{
  "opencollection": "1.0.0",
  "info": {
    "name": "Deel ATS Adjustments Contractor Hiring API",
    "version": "2026-05-25"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Contractor Hiring",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create A New Contract",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.letsdeel.com/rest/v2/contracts/ic",
            "headers": [
              {
                "name": "Idempotency-Key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create an Independent Contractor contract (ongoing, PAYG, milestone, or COR variant)."
        },
        {
          "info": {
            "name": "Add External ID",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.letsdeel.com/rest/v2/contracts/:contract_id/external-id",
            "params": [
              {
                "name": "contract_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Attach a client-side external ID to a contract for cross-system reconciliation."
        }
      ]
    }
  ],
  "bundled": true
}