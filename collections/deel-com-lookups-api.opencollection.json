{
  "opencollection": "1.0.0",
  "info": {
    "name": "Deel ATS Adjustments Lookups API",
    "version": "2026-05-25"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Lookups",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve Country List",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.letsdeel.com/rest/v2/lookups/countries"
          },
          "docs": "Returns all countries with visa support, EOR availability, and sub-territories."
        },
        {
          "info": {
            "name": "Retrieve Supported Currency List",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.letsdeel.com/rest/v2/lookups/currencies"
          },
          "docs": "Retrieve Supported Currency List"
        },
        {
          "info": {
            "name": "Job Titles List",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.letsdeel.com/rest/v2/lookups/job-titles"
          },
          "docs": "Job Titles List"
        },
        {
          "info": {
            "name": "Retrieve Seniority Levels",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.letsdeel.com/rest/v2/lookups/seniority-levels"
          },
          "docs": "Retrieve Seniority Levels"
        }
      ]
    }
  ],
  "bundled": true
}