            "headers": [
              {
                "name": "Idempotency-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "contract_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create Contractor Amendment"
        },
        {
          "info": {
            "name": "Bulk Sign Contracts And Amendments",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.letsdeel.com/rest/v2/contracts/:contract_id/amendments/bulk-sign",
            "params": [
              {
                "name": "contract_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Sign multiple contract amendments programmatically."
        }
      ]
    }
  ],
  "bundled": true
}