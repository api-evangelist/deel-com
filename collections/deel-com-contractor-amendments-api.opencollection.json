{
  "opencollection": "1.0.0",
  "info": {
    "name": "Deel ATS Adjustments Contractor Amendments API",
    "version": "2026-05-25"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Contractor Amendments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
